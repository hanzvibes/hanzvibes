#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

DISTRO="debian"
AI_HOME="${HOME}/.termux-ai"
mkdir -p "$AI_HOME"

say() { printf '\n\033[1;36m[Termux AI]\033[0m %s\n' "$*"; }
warn() { printf '\n\033[1;33m[Termux AI]\033[0m %s\n' "$*" >&2; }
die() { printf '\n\033[1;31m[Termux AI]\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'TXT'
Usage: termux-ai <command>

Commands:
  codex          Install if needed, then launch OpenAI Codex CLI
  opencode       Install if needed, then launch OpenCode v2
  antigravity    Install if needed, then launch Google Antigravity CLI
  claude         Install if needed, then launch Claude Code
  gemini         Install if needed, then launch Gemini CLI
  grok           Install if needed, then launch Grok Build
  update-all     Refresh all installed AI CLIs
  status         Show runtime + CLI status
TXT
}

ensure_host_runtime() {
  command -v pkg >/dev/null 2>&1 || die "This launcher must run inside Termux."

  if ! command -v proot-distro >/dev/null 2>&1; then
    say "Preparing AI runtime..."
    pkg update -y
    pkg install -y proot-distro
  fi

  if ! proot-distro login "$DISTRO" -- /bin/true >/dev/null 2>&1; then
    say "Installing Debian compatibility environment..."
    proot-distro install "$DISTRO"
  fi
}

container_workdir() {
  if [[ "$PWD" == "$HOME" ]]; then
    printf '/root'
  elif [[ "$PWD" == "$HOME/"* ]]; then
    printf '/root/%s' "${PWD#"$HOME/"}"
  else
    printf '/root'
  fi
}

linux() {
  proot-distro login "$DISTRO" --termux-home --shared-tmp -- bash -lc "$1"
}

ensure_linux_base() {
  ensure_host_runtime
  if ! linux 'command -v curl >/dev/null && command -v git >/dev/null && command -v node >/dev/null && command -v npm >/dev/null' >/dev/null 2>&1; then
    say "Preparing Linux packages for AI CLIs..."
    linux 'export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y ca-certificates curl git bash nodejs npm'
  fi
}

path_env='export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.grok/bin:$HOME/.npm-global/bin:/usr/local/bin:/usr/bin:/bin:$PATH"; npm config set prefix "$HOME/.npm-global" >/dev/null 2>&1 || true'

is_installed() {
  local cmd="$1"
  ensure_linux_base
  linux "$path_env; command -v $cmd >/dev/null 2>&1"
}

install_codex() {
  say "Installing/updating OpenAI Codex CLI..."
  linux "$path_env; export CODEX_NON_INTERACTIVE=1; curl -fsSL https://chatgpt.com/codex/install.sh | sh"
}

install_opencode() {
  say "Installing/updating OpenCode v2..."
  linux "$path_env; curl -fsSL https://opencode.ai/v2/install | bash"
}

install_antigravity() {
  say "Installing/updating Google Antigravity CLI..."
  linux "$path_env; curl -fsSL https://antigravity.google/cli/install.sh | bash"
}

install_claude() {
  say "Installing/updating Claude Code..."
  linux "$path_env; curl -fsSL https://claude.ai/install.sh | bash"
}

install_gemini() {
  say "Installing/updating Gemini CLI..."
  linux "$path_env; npm install -g @google/gemini-cli@latest"
}

install_grok() {
  say "Installing/updating Grok Build..."
  linux "$path_env; curl -fsSL https://x.ai/cli/install.sh | bash"
}

install_tool() {
  case "$1" in
    codex) install_codex ;;
    opencode) install_opencode ;;
    agy) install_antigravity ;;
    claude) install_claude ;;
    gemini) install_gemini ;;
    grok) install_grok ;;
    *) die "Unknown tool: $1" ;;
  esac
}

run_tool() {
  local cmd="$1"
  local installer_key="$2"
  ensure_linux_base

  if ! is_installed "$cmd"; then
    install_tool "$installer_key"
  fi

  local work
  work="$(container_workdir)"
  say "Launching $cmd..."
  exec proot-distro login "$DISTRO" --termux-home --shared-tmp --work-dir "$work" -- \
    bash -lc "$path_env; exec $cmd"
}

update_all() {
  ensure_linux_base
  local updated=0
  if is_installed codex; then install_codex; updated=1; fi
  if is_installed opencode; then install_opencode; updated=1; fi
  if is_installed agy; then install_antigravity; updated=1; fi
  if is_installed claude; then install_claude; updated=1; fi
  if is_installed gemini; then install_gemini; updated=1; fi
  if is_installed grok; then install_grok; updated=1; fi
  if [[ "$updated" -eq 0 ]]; then
    warn "No AI CLI is installed yet. Open one from AI Hub to install it on demand."
  else
    say "Update complete."
  fi
}

status() {
  ensure_linux_base
  say "Compatibility runtime: Debian via proot-distro"
  for pair in 'Codex:codex' 'OpenCode:opencode' 'Antigravity:agy' 'Claude:claude' 'Gemini:gemini' 'Grok:grok'; do
    name="${pair%%:*}"
    cmd="${pair##*:}"
    if is_installed "$cmd"; then
      version="$(linux "$path_env; $cmd --version 2>/dev/null | head -n 1" || true)"
      printf '  %-14s installed%s\n' "$name" "${version:+  ($version)}"
    else
      printf '  %-14s not installed\n' "$name"
    fi
  done
}

case "${1:-}" in
  codex) run_tool codex codex ;;
  opencode) run_tool opencode opencode ;;
  antigravity|agy) run_tool agy agy ;;
  claude) run_tool claude claude ;;
  gemini) run_tool gemini gemini ;;
  grok) run_tool grok grok ;;
  update-all) update_all ;;
  status) status ;;
  help|-h|--help|'') usage ;;
  *) usage; die "Unknown command: $1" ;;
esac
