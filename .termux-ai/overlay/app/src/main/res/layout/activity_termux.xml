<?xml version="1.0" encoding="utf-8"?>
<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F12"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="8dp"
                android:paddingEnd="10dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/workspace_home_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="‹"
                        android:textColor="#E7E9ED"
                        android:textSize="24sp"
                        app:backgroundTint="#181B20"
                        app:cornerRadius="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/workspace_session_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="Terminal"
                            android:textColor="#F4F5F7"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="Local workspace"
                            android:textColor="#737A85"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ai_hub_button"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="AI"
                        android:textAllCaps="false"
                        android:textColor="#A7FF4F"
                        android:textStyle="bold"
                        app:backgroundTint="#182015"
                        app:cornerRadius="14dp"
                        app:strokeColor="#2D4222"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/session_drawer_button"
                        android:layout_width="42dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="☰"
                        android:textColor="#D8DBE0"
                        android:textSize="16sp"
                        app:backgroundTint="#181B20"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#090A0C"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#272A31"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.termux.view.TerminalView
                            android:id="@+id/terminal_view"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingStart="10dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="8dp"
                            android:defaultFocusHighlightEnabled="false"
                            android:focusableInTouchMode="true"
                            android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                            android:scrollbars="vertical"
                            tools:ignore="UnusedAttribute" />

                        <WebView
                            android:id="@+id/ai_terminal_viewport"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#090A0C"
                            android:importantForAccessibility="yes"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/terminal_toolbar_view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="37.5dp"
                    android:layout_marginTop="6dp"
                    android:background="#111318"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/native_command_composer"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/ai_composer_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="7dp">

                    <EditText
                        android:id="@+id/command_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Type a command…"
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="#EEF0F3"
                        android:textColorHint="#676E78"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/send_command_button"
                        android:layout_width="42dp"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="↑"
                        android:textColor="#111318"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="#A7FF4F"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="288dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@drawable/ai_drawer_bg"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sessions"
                        android:textColor="#F1F3F5"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/action_open_settings"
                        android:src="@drawable/ic_settings"
                        app:tint="#AAB0BA" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:text="Switch between running terminal and AI sessions."
                    android:textColor="#6F7680"
                    android:textSize="12sp" />

                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:divider="@android:color/transparent"
                    android:dividerHeight="4dp"
                    android:longClickable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/new_session_button"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/action_new_session"
                    android:textAllCaps="false"
                    android:textColor="#111318"
                    android:textStyle="bold"
                    app:backgroundTint="#A7FF4F"
                    app:cornerRadius="15dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggle_keyboard_button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="Keyboard / extra keys"
                    android:textAllCaps="false"
                    android:textColor="#D8DBE0"
                    app:backgroundTint="#1A1D23"
                    app:cornerRadius="15dp"
                    app:strokeColor="#2B2F37"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>
    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>