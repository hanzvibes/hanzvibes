<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E0F"
    android:fitsSystemWindows="true">

    <!-- HOME / PROJECT LAUNCHER -->
    <ScrollView
        android:id="@+id/native_home_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="34dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/native_app_icon"
                    android:contentDescription="AI Workspace"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI Workspace"
                        android:textColor="#F5F5F5"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Local builder"
                        android:textColor="#7E8085"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/native_settings_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:text="•••"
                    android:textColor="#D6D7DA"
                    android:textSize="14sp"
                    app:backgroundTint="#191A1C"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="What will you build?"
                android:textColor="#F4F4F5"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Describe an idea and start a local AI workspace."
                android:textColor="#85878D"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/replit_prompt_bg"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/native_home_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="Build me a..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:padding="2dp"
                    android:textColor="#F0F0F1"
                    android:textColorHint="#686A6F"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/replit_runtime_dot" />

                    <TextView
                        android:id="@+id/native_runtime_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Preparing local runtime…"
                        android:textColor="#888A8F"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/native_runtime_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:text="PREPARING" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/native_home_build_button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minHeight="0dp"
                        android:text="Start building"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="#F26207"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/native_new_shell_button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="+ New shell"
                    android:textAllCaps="false"
                    android:textColor="#E3E4E6"
                    app:backgroundTint="#18191B"
                    app:cornerRadius="12dp"
                    app:strokeColor="#303236"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/native_refresh_button"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="Refresh"
                    android:textAllCaps="false"
                    android:textColor="#E3E4E6"
                    app:backgroundTint="#18191B"
                    app:cornerRadius="12dp"
                    app:strokeColor="#303236"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Agents"
                    android:textColor="#EEEEEF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Local tools"
                    android:textColor="#71737A"
                    android:textSize="11sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/native_agent_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alignmentMode="alignMargins"
                android:columnCount="2"
                android:useDefaultMargins="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent workspaces"
                    android:textColor="#EEEEEF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/native_session_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 active"
                    android:textColor="#71737A"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/native_sessions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- REPLIT-STYLE MOBILE WORKSPACE -->
    <LinearLayout
        android:id="@+id/native_workspace_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0E0E0F"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/native_back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:text="‹"
                android:textColor="#E6E6E8"
                android:textSize="24sp"
                app:backgroundTint="#191A1C"
                app:cornerRadius="11dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/native_workspace_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Workspace"
                    android:textColor="#F4F4F5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/native_workspace_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:text="Local workspace"
                    android:textColor="#76787E"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/native_workspace_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="RUNNING"
                android:textColor="#57D082"
                android:textSize="9sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/native_workspace_menu_button"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:text="•••"
                android:textColor="#C9CACD"
                android:textSize="12sp"
                app:backgroundTint="#191A1C"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#242529" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/native_tab_agent"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Agent"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2A211D"
                app:cornerRadius="9dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/native_tab_console"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Console"
                android:textAllCaps="false"
                android:textColor="#8B8D92"
                app:backgroundTint="#0E0E0F"
                app:cornerRadius="9dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/native_tab_files"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="Files"
                android:textAllCaps="false"
                android:textColor="#8B8D92"
                app:backgroundTint="#0E0E0F"
                app:cornerRadius="9dp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/native_agent_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/native_message_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:scrollbars="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/replit_composer_bg"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="7dp">

                        <EditText
                            android:id="@+id/native_composer_input"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@android:color/transparent"
                            android:gravity="top|start"
                            android:hint="Ask Agent..."
                            android:imeOptions="actionSend"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="4"
                            android:padding="0dp"
                            android:textColor="#F1F1F2"
                            android:textColorHint="#686A70"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Local • current workspace"
                                android:textColor="#6F7177"
                                android:textSize="10sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/native_interrupt_button"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="5dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:text="■"
                                android:textColor="#C7C8CB"
                                android:textSize="10sp"
                                app:backgroundTint="#25262A"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/native_send_button"
                                android:layout_width="38dp"
                                android:layout_height="34dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:insetLeft="0dp"
                                android:insetTop="0dp"
                                android:insetRight="0dp"
                                android:insetBottom="0dp"
                                android:text="↑"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                app:backgroundTint="#F26207"
                                app:cornerRadius="10dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <ScrollView
                android:id="@+id/native_console_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#101112"
                android:fillViewport="true"
                android:padding="14dp"
                android:scrollbars="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/native_console_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:text="Console output will appear here."
                    android:textColor="#D4D5D7"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/native_files_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#111214"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/native_files_up_button"
                        android:layout_width="36dp"
                        android:layout_height="34dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:text="↑"
                        android:textColor="#C9CACD"
                        app:backgroundTint="#1D1E21"
                        app:cornerRadius="9dp" />

                    <TextView
                        android:id="@+id/native_files_path"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:text="~"
                        android:textColor="#989A9F"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#25262A" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/native_files_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="12dp" />
                </ScrollView>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/native_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EA0E0E0F"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/native_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Preparing workspace…"
                android:textColor="#E6E6E8"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
